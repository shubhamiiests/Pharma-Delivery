<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PharmaDelivery" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PharmaDelivery.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#00897B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.PharmaDelivery</item>
    </style>
</resources>
